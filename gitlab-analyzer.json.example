{
  "gitlab": {
    "url": "https://gitlab.com"
  },
  "defaults": {
    "branch": "develop",
    "repoNameFilter": "-front",
    "excludeRepos": [],
    "pathFilter": "/src/",
    "includeTests": false
  },
  "commands": {
    "find-matches": {
      "concurrency": 5,
      "output": "./results/find-matches.json"
    }
  }
}
